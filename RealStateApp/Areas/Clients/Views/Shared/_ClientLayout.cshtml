@using System.Security.Cryptography
@inject UserManager<AppUser> UserManager

@{
    var defaultProfileImage = "https://i.pinimg.com/originals/aa/13/91/aa13915873372c1bb99ff81fbc17f611.jpg";
    var user = await UserManager.GetUserAsync(User);
    var profileImage = user?.Photo ?? defaultProfileImage;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealStateApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/%40mdi/font%407.4.47/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="https://cdn-uicons.flaticon.com/3.0.0/uicons-solid-rounded/css/uicons-solid-rounded.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
       
        :root {
            --primary-bg: #F4F6F9;
            --secondary-bg: #FFFFFF;
            --accent-color: #0D6EFD;
            --hover-bg: #E7F1FF;
            --text-dark: #212529;
            --text-muted: #6C757D;
        }
    </style>
</head>
@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
<body class="flex flex-col min-h-screen bg-[var(--primary-bg)] text-[var(--text-dark)] font-sans">

    <header class="bg-gradient-to-br from-black via-gray-900 to-gray-800 shadow-xl rounded-b-xl">

        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <a hasp-area="Clients" asp-controller="Home" asp-action="Index"
            class="flex items-center gap-2 text-white font-bold text-xl">
                <i class="fi fi-sr-home-heart"></i> RealStateApp
            </a>

            <nav class="flex items-center gap-4">
                <a asp-area="Clients" asp-controller="Home" asp-action="Index"
                   class="px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white flex items-center gap-1 text-white transition">
                    <i class="fi fi-sr-home"></i> HOME
                </a>

                <a asp-area="Clients" asp-controller="Home" asp-action="Agents"
                   class="px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white flex items-center gap-1 text-white transition">
                    <i class="fi fi-sr-users"></i> Agentes
                </a>

                <a asp-area="Clients" asp-controller="Home" asp-action="FavoriteProperty"
                   class="px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white flex items-center gap-1 text-white transition">
                    <i class="fi fi-sr-building"></i> Mi Propiedades
                </a>

                <div class="relative" id="userDropdown">
                    <button id="dropdownButton"
                            class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-white/10 text-white transition">
                        <img src="@Url.Content(profileImage)"
                             alt="Perfil"
                             class="w-10 h-10 rounded-full border-2 border-white shadow-sm" />
                               @(user!.FirstName ?? "KIO")
                        <i class="fi fi-sr-angle-down ml-1"></i>
                    </button>

                    <ul id="dropdownMenu"
                        class="absolute right-0 mt-2 bg-white shadow-lg rounded-lg py-1 w-44 hidden z-50">
                        <li>
                            <a asp-area="Clients" asp-controller="Home" asp-action="Index"
                               class="block px-4 py-2 hover:bg-gray-100 hover:text-gray-800 flex items-center gap-2">
                                <i class="fi fi-sr-user"></i> Mi Perfil
                            </a>
                        </li>
                        <li><hr class="my-1 border-gray-200"></li>
                        <li>
                            <a asp-area="" asp-controller="Login" asp-action="Logout"
                               class="block px-4 py-2 hover:bg-gray-100 hover:text-gray-800 flex items-center gap-2">
                                <i class="fi fi-sr-sign-out-alt"></i> Cerrar Sesión
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>
    </header>


  
    <main class="flex-1 max-w-7xl mx-auto px-6 py-8 w-full">
        @RenderBody()
    </main>

    <footer class="bg-[var(--secondary-bg)] text-center py-4 text-[var(--text-muted)] shadow-inner mt-auto">
        &copy; @DateTime.Now - RealStateApp
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.15.0/dist/cdn.min.js" defer></script>
    <script src="@Url.Content("~/js/site.js")" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<script>
    const button = document.getElementById('dropdownButton');
    const menu = document.getElementById('dropdownMenu');

    button.addEventListener('click', () => {
        menu.classList.toggle('hidden');
    });

  
    document.addEventListener('click', (e) => {
        if (!document.getElementById('userDropdown').contains(e.target)) {
            menu.classList.add('hidden');
        }
    });
</script>

