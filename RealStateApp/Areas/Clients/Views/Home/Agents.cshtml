@model AgentDataListViewModel

@{

    Layout = "_ClientLayout";
    ViewData["Title"] = "Listado de agentes";

}

<section class="w-full">
    <div class="relative h-64 md:h-72 lg:h-96 overflow-hidden rounded-b-lg shadow-md">
        <img src="https://static.vecteezy.com/system/resources/previews/001/986/645/large_2x/home-owner-receiving-keys-free-photo.jpg"
             alt="Banner agentes"
             class="absolute inset-0 w-full h-full object-cover filter brightness-75" />
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
            <h1 class="text-2xl md:text-4xl lg:text-5xl font-extrabold text-white drop-shadow">
                Conoce a nuestros agentes
            </h1>
            <p class="mt-2 text-sm md:text-lg text-gray-200 max-w-2xl">
                Encuentra el agente ideal para ayudarte a descubrir tu próxima propiedad.
            </p>
        </div>
    </div>
</section>


<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700">Nombre del agente</label>
        <input type="text"
               id="agentFilter"
               placeholder="Buscar agente..."
               class="w-full md:w-1/2 px-4 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
               oninput="debounce(applyAgentFilter, 'agentFilter', 500)" />
    </div>


    <div id="agent-list">
        <partial name="_AgentList" model="Model" />
    </div>
</section>

@section Scripts {
    <script>
        const debounceMap = {};

        function debounce(fn, key, delay = 500) {
            if (debounceMap[key]) clearTimeout(debounceMap[key]);
            debounceMap[key] = setTimeout(fn, delay);
        }

        async function applyAgentFilter() {
            const name = document.getElementById("agentFilter").value;

            try {
                const response = await fetch(`@Url.Action("FilterAgentsAjax", "Home")?name=${encodeURIComponent(name)}`);
                const html = await response.text();
                document.getElementById("agent-list").innerHTML = html;
            } catch (err) {
                console.error("Error AJAX al filtrar agentes:", err);
            }
        }


                document.getElementById("agentFilter").addEventListener("input", function () {
            if (this.value.trim() === "") {
                window.location.href = "/Clients/Home/Agents";
            }
        });
    </script>
}
