@using RealStateApp.Core.Application.ViewModels.Properties
@model DataPropertyListViewModel

@{
    Layout = "LayoutGeneral";
    ViewData["Title"] = "Propiedades disponibles";
}

<section class="w-full">
    <div class="relative h-64 md:h-72 lg:h-96 overflow-hidden rounded-b-lg shadow-md">
        <img src="https://media.diariouno.com.ar/p/ac3f521f4945fabe37755acbdbce2092/adjuntos/298/imagenes/009/351/0009351562/1200x675/smart/como-comprar-una-casa-credito-hipotecario-banco-nacionpng.png"
             alt="Banner propiedades"
             class="absolute inset-0 w-full h-full object-cover filter brightness-75" />
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
            <h1 class="text-2xl md:text-4xl lg:text-5xl font-extrabold text-white drop-shadow">
                Encuentra tu próxima propiedad
            </h1>
            <p class="mt-2 text-sm md:text-lg text-gray-200 max-w-2xl">
                Explora las mejores opciones disponibles — filtra por código, tipo, precio, habitaciones y baños.
            </p>
        </div>
    </div>
</section>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-md bg-green-50 border border-green-200 p-4 flex justify-between items-center" id="success-message">
            <p class="text-green-800 font-medium">@TempData["Success"]</p>
            <button onclick="this.parentElement.remove()" class="text-green-800 font-bold">&times;</button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded-md bg-yellow-50 border border-yellow-200 p-4 flex justify-between items-center" id="error-message">
            <p class="text-yellow-800 font-medium">@TempData["Error"]</p>
            <button onclick="this.parentElement.remove()" class="text-yellow-800 font-bold">&times;</button>
        </div>
    }


    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
      
        <div class="lg:col-span-1 bg-white p-4 rounded-lg shadow-md sticky top-6">
            <label class="block text-sm font-medium text-gray-700">Buscar por código</label>
            <input name="code"
                   type="text"
                   placeholder="Ej: COD1234"
                   class="w-full px-4 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                   oninput="debounce(() => applyFiltersAjax(), 'code')" />
            <p class="text-xs text-gray-500 mt-1">Escribe el código exacto. Si no se encuentra, verás un mensaje.</p>
        </div>

      
        <div class="lg:col-span-2 bg-white p-4 rounded-lg shadow-md grid grid-cols-1 md:grid-cols-4 gap-4">

           
            <div>
                <label class="block text-sm font-medium text-gray-700">Tipo de propiedad</label>
                <input name="propertyType"
                       type="text"
                       placeholder="Casa, Apartamento..."
                       class="w-full pl-3 pr-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"
                       oninput="debounce(() => applyFiltersAjax(), 'type')" />
            </div>

         
            <div>
                <label class="block text-sm font-medium text-gray-700">Precio mínimo</label>
                <input name="priceMIN"
                       type="number"
                       min="0"
                       step="0.01"
                       placeholder="0"
                       class="w-full pl-3 pr-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"
                       oninput="debounce(() => applyFiltersAjax(), 'min')" />
            </div>

       
            <div>
                <label class="block text-sm font-medium text-gray-700">Precio máximo</label>
                <input name="priceMax"
                       type="number"
                       min="0"
                       step="0.01"
                       placeholder="0"
                       class="w-full pl-3 pr-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"
                       oninput="debounce(() => applyFiltersAjax(), 'max')" />
            </div>

          
            <div>
                <label class="block text-sm font-medium text-gray-700">Habitaciones</label>
                <input name="bedrooms"
                       type="number"
                       min="0"
                       placeholder="0"
                       class="w-full pl-3 pr-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"
                       oninput="debounce(() => applyFiltersAjax(), 'bedrooms')" />
            </div>

         
            <div>
                <label class="block text-sm font-medium text-gray-700">Baños</label>
                <input name="bathrooms"
                       type="number"
                       min="0"
                       placeholder="0"
                       class="w-full pl-3 pr-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"
                       oninput="debounce(() => applyFiltersAjax(), 'bathrooms')" />
            </div>

        </div>
    </div>

   
    <div id="property-list">
        <partial name="_ListPropertyHome" model="new PropertyListViewModel { DataProperties = Model.ListProperty }" />
    </div>

</main>

@section Scripts {
    <script>
        const debounceMap = {};

        function debounce(fn, key, delay = 500) {
            if (debounceMap[key]) clearTimeout(debounceMap[key]);
            debounceMap[key] = setTimeout(fn, delay);
        }

        function applyFiltersAjax() {
            const params = new URLSearchParams({
                code: document.querySelector("input[name='code']")?.value,
                propertyType: document.querySelector("input[name='propertyType']")?.value,
                priceMIN: document.querySelector("input[name='priceMIN']")?.value,
                priceMax: document.querySelector("input[name='priceMax']")?.value,
                bedrooms: document.querySelector("input[name='bedrooms']")?.value,
                bathrooms: document.querySelector("input[name='bathrooms']")?.value
            });

            fetch(`/Home/FilterAjax?${params.toString()}`)
                .then(res => res.text())
                .then(html => {
                    document.getElementById("property-list").innerHTML = html;
                })
                .catch(err => console.error("Error AJAX:", err));
        }
    </script>
}